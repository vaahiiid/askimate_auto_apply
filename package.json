{
  "name": "askimate-aas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "sh -c 'case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"This repository uses pnpm. Run: corepack enable && pnpm install\" >&2; exit 1 ;; esac'",
    "typecheck": "tsc --build --verbose",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "walkthrough": "tsx scripts/walkthrough.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run boundaries && pnpm run test",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@askimate/aas-case-store": "workspace:*",
    "@askimate/aas-domain": "workspace:*",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
