{
  "name": "askimate-aas",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "sh -c 'case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"This repository uses pnpm. Run: corepack enable && pnpm install\" >&2; exit 1 ;; esac'",
    "typecheck": "tsc --build --verbose",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "walkthrough": "tsx scripts/walkthrough.ts",
    "interview-demo": "tsx scripts/interview-demo.ts",
    "extraction-demo": "tsx scripts/extraction-demo.ts",
    "end-to-end": "tsx scripts/end-to-end.ts",
    "verify-bedrock": "tsx scripts/verify-bedrock.ts",
    "inspect-discovery": "tsx scripts/inspect-discovery.ts",
    "retention-status": "tsx scripts/retention-status.ts",
    "discover": "pnpm --filter @askimate/aas-browser-runner exec tsx src/cli.ts",
    "verify": "pnpm install --frozen-lockfile && pnpm run typecheck && pnpm run lint && pnpm run boundaries && pnpm run version:check && pnpm run test",
    "clean": "tsc --build --clean",
    "analyse-journey": "tsx scripts/analyse-journey.ts",
    "inspect": "pnpm --filter @askimate/aas-browser-runner exec tsx src/inspect-cli.ts",
    "verify:integration": "bash scripts/with-postgres.sh",
    "version:check": "tsx scripts/version.ts check",
    "version:set": "tsx scripts/version.ts set",
    "version:bump": "tsx scripts/version.ts bump"
  },
  "devDependencies": {
    "@askimate/aas-account": "workspace:*",
    "@askimate/aas-blueprint": "workspace:*",
    "@askimate/aas-browser-fill": "workspace:*",
    "@askimate/aas-browser-runner": "workspace:*",
    "@askimate/aas-case-store": "workspace:*",
    "@askimate/aas-chat-integration": "workspace:*",
    "@askimate/aas-contracts": "workspace:*",
    "@askimate/aas-conversation": "workspace:*",
    "@askimate/aas-conversation-service": "workspace:*",
    "@askimate/aas-disclosure": "workspace:*",
    "@askimate/aas-documents": "workspace:*",
    "@askimate/aas-domain": "workspace:*",
    "@askimate/aas-extraction": "workspace:*",
    "@askimate/aas-interview": "workspace:*",
    "@askimate/aas-llm": "workspace:*",
    "@askimate/aas-mapping": "workspace:*",
    "@askimate/aas-migrate": "workspace:*",
    "@askimate/aas-orchestrator": "workspace:*",
    "@askimate/aas-preparation": "workspace:*",
    "@askimate/aas-profile": "workspace:*",
    "@askimate/aas-requirements": "workspace:*",
    "@askimate/aas-secrets": "workspace:*",
    "@askimate/aas-secure-filler": "workspace:*",
    "@askimate/aas-secure-logging": "workspace:*",
    "@askimate/aas-secure-service": "workspace:*",
    "@aws-sdk/client-bedrock": "^3.1118.0",
    "@aws-sdk/client-sts": "^3.1118.0",
    "@eslint/js": "^9.18.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/semver": "^7.8.0",
    "esbuild": "0.21.5",
    "eslint": "^9.18.0",
    "js-yaml": "^4.3.1",
    "semver": "^7.8.5",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
